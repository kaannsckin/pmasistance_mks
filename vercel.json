{
  "rewrites": [
    {
      "source": "/api/cloud/config",
      "destination": "/api/integrations/health?route=cloud-config"
    }
  ],
  "functions": {
    "api/ai/*.ts": {
      "maxDuration": 60
    },
    "api/integrations/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/integrations/cron-reminder",
      "schedule": "0 7 * * 4"
    }
  ]
}
