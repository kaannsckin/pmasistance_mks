# Kurumsal AI asistanı — bu dosyayı .env.local olarak kopyalayın (git'e girmez).
# Değerler YALNIZCA sunucu tarafında (Vite geliştirme sunucusu / Vercel fonksiyonu) okunur;
# tarayıcı paketine gömülmez. Ayrıntı: docs/AI_KURULUM.md

# openai | azure | anthropic | gemini
# Örnek — TÜBİTAK BİLGEM AI API: AI_PROVIDER=openai, AI_BASE_URL=https://ai-api.bilgem.tubitak.gov.tr/v1, AI_MODEL=general
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
# Azure ya da OpenAI-uyumlu kurum içi uç nokta için:
# AI_BASE_URL=https://llm.kurum.local/v1

# Yayında erişim koruması (biri zorunlu):
# AI_ACCESS_TOKEN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# İsteğe bağlı
# AI_MAX_OUTPUT_TOKENS=4096
# AI_TEMPERATURE=0.3
# AI_REASONING_EFFORT=medium   # none | minimal | low | medium | high
# AI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# AI_RATE_LIMIT_PER_MIN=60
# AI_TIMEOUT_MS=55000
# AI_ALLOWED_ORIGINS=https://planasistan.vercel.app

# Anlamsal arama / RAG (isteğe bağlı). Verilmezse anahtar kelime araması kullanılır.
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_PROVIDER=        # openai | azure | gemini | voyage (Anthropic sohbetinde zorunlu)
# AI_EMBEDDING_API_KEY=         # farklı sağlayıcıysa
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_DIMENSIONS=
# AI_EMBED_RATE_LIMIT_PER_MIN=120
